# Written by `npm run up:<mode>` (experiments/up.ts). You do not normally edit it by hand.
# Mode switches (overwritten on every `npm run up:<mode>`):
#   baseline: FT_ENABLED=0 ENDTERM_ENABLED=0 FINAL_ENABLED=0 RESTART_POLICY=no             NGINX_PROFILE=single
#   midterm:  FT_ENABLED=1 ENDTERM_ENABLED=0 FINAL_ENABLED=0 RESTART_POLICY=unless-stopped NGINX_PROFILE=single
#   endterm:  FT_ENABLED=1 ENDTERM_ENABLED=1 FINAL_ENABLED=0 RESTART_POLICY=unless-stopped NGINX_PROFILE=redundant
#   final:    FT_ENABLED=1 ENDTERM_ENABLED=1 FINAL_ENABLED=1 RESTART_POLICY=unless-stopped NGINX_PROFILE=redundant
FT_ENABLED=1
ENDTERM_ENABLED=1
FINAL_ENABLED=1
RESTART_POLICY=unless-stopped
NGINX_PROFILE=redundant
# Secrets: kept if already present, otherwise generated (24 random bytes, base64url).
# .env is git-ignored; never commit real values. Leave these empty here: empty means "generate".
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REPL_PASSWORD=
MONITOR_DB_PASSWORD=
FAILOVER_DB_PASSWORD=
BACKUP_DB_PASSWORD=
JWT_SECRET=
CHAOS_TOKEN=
DEMO_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
